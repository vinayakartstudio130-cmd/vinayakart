NODE_ENV=development
PORT=5000

# Frontend API base URL used by Vite.
# Local full-stack development:
VITE_API_BASE_URL=http://localhost:5000
# Vercel production example:
# VITE_API_BASE_URL=https://your-api-service.onrender.com

# Comma-separated list of frontend origins allowed to call the API.
# For Render, set this to your deployed frontend/backend URL, for example:
# CLIENT_ORIGIN=https://your-service-name.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Admin panel credentials. Visit /admin after deployment.
ADMIN_NAME=VinayakArt Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
JWT_SECRET=change-this-long-random-secret

# Razorpay payment gateway.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
